## Twilio (SMS)
# Set these to your Twilio account values to enable real SMS sending
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+1234567890
ADMIN_SMS=1234567890

# If you want emails in addition to SMS, enable and configure these
# SEND_EMAILS=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass
# ADMIN_EMAIL=admin@freshmart.com

# Or use SendGrid (no SMTP) — set this to enable SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxx
# FROM_EMAIL=no-reply@yourdomain.com
