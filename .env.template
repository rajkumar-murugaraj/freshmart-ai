# Copy this file to `.env` and fill the values.
# Do NOT commit your real keys to source control.

# Toggle to enable sending real emails (false = log only)
SEND_EMAILS=false

# Toggle to enable sending SMS via Twilio (false = don't send SMS)
# Set to 'true' to allow SMS sending when Twilio credentials are present
SEND_SMS=false

# SendGrid (preferred for email)
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@freshmart.local
ADMIN_EMAIL=admin@freshmart.local

# Or, if you prefer SMTP, provide these instead (used when SENDGRID_API_KEY is empty)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Twilio (for SMS). For trial accounts, verify destination numbers in Twilio dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+11234567890
ADMIN_SMS=9342277609

# Optional: change backend port if you want
# PORT=3001
